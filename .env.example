# Optional: OpenAPI contact (email recommended for AgentCash/Poncho ownership)
# CONTACT_EMAIL=you@example.com
# CONTACT_URL=https://github.com/gaharuty-stack/price-bot

# Optional: promo.py --auto (allowlisted chats in promo_targets.json)
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# Strongly recommended in production (without it CoinGecko 429 → 5xx/slow)
