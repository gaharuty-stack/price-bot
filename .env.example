# Required in production
INTEGRITY_SECRET=change-me-to-long-random-string
TOLLBOOTH_SECRET=change-me-to-long-random-string
ADMIN_TOKEN=change-me-admin-token

# Wallet
PAY_TO=0x3f10530c86e6a1d26edbf27b6b6e660c77d79915
# Optional override (defaults to 0.001). Stale PRICE_USDC on Railway is ignored.
PRICE_USDC_OVERRIDE=0.001
PAYMENT_NETWORK=base
X402_FACILITATOR_URL=https://facilitator.payai.network
FLASK_TARGET=http://127.0.0.1:5000

# Public URL (for OpenAPI servers field)
SERVICE_URL=https://price-bot-production-4d6a.up.railway.app

# OpenAPI contact (recommended for AgentCash ownership / discover)
CONTACT_EMAIL=gaharuty@gmail.com
CONTACT_URL=https://github.com/gaharuty-stack/price-bot

# Strongly recommended in production (without it CoinGecko 429 → 5xx/slow)
# Free demo key: https://www.coingecko.com/en/api/pricing
COINGECKO_API_KEY=

# Railway sets PORT automatically
PORT=10000
